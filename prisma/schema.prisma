datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  username String?
  role     Role   @default(STANDARD)
  password String
}

enum Role {
  STANDARD
  ADMIN
}

model Donors {
  id        Int    @id @default(autoincrement())
  email     String @unique
  firstName String
  lastName  String
}



