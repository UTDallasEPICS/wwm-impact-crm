
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model BloomerangUser {
  id             String             @id @default(uuid())
  email          String             @unique
  username       String?
  password       String?
  role           Role               @default(STANDARD)

  // From diagram
  accountNum     String             @unique // Account Num: String UUID
  note           String?
  purpose        String?
  transactions   Int?
  inbound        Boolean?
  subject        String?
  channel        String?
  reasonForInterest String?

  level          String?
  createdDate    DateTime?          // Created Date
  createdName    String?
  lastModifiedDate DateTime?        // Last Modified Date
  lastModifiedName String?
  askAmounts     Int?

  // Additional Fields
  country        String?
  isActive       Boolean?           @default(true)
  language       String?
  name           String?
  phone          String?
  sortName       String?
  timeZone       String?
  
  // Relations
  organizations  BloomerangUserOrganization[]
}

model User {
  name          String
  email         String
  emailVerified Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  id            String             @id @default(uuid())
  image         String?
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

enum Role {
  STANDARD
  ADMIN
}

model Organization {
  id   String @id @default(uuid())
  name String

  users   BloomerangUserOrganization[]
  donors  Donor[]
  funds   Fund[]
  reports Report[]
}

model Donor {
  id             String       @id @default(uuid())
  email          String
  firstName      String
  lastName       String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  donations     Donation[]
  constituentId String      @unique
  constituent   Constituent @relation(fields: [constituentId], references: [id], onDelete: Cascade)
  // ensures uniqueness within an org
  @@unique([organizationId, email])
}

model Report {
  id     String     @id @default(uuid())
  name   String
  type   ReportType @default(CUSTOM)
  config Json // filters/metrics stored here

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ReportType {
  ORG_KPI
  FUND_PERFORMANCE
  DONOR_DRILLDOWN
  CUSTOM
}

model BloomerangUserOrganization {
  id             String @id @default(uuid())
  userId         String
  organizationId String

  user         BloomerangUser         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
}

enum Gender {
  UNKNOWN
  MALE
  FEMALE
  NON_BINARY
}

enum AddressType {
  HOME
  WORK
  BILLING
  SHIPPING
  OTHER
}

enum PhoneType {
  MOBILE
  HOME
  WORK
  OTHER
}

enum EmailType {
  PERSONAL
  WORK
  OTHER
}

enum EventStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELED
}

enum EventType {
  MEETING
  CALL
  EMAIL
  IN_PERSON
  FUNDRAISER
  OTHER
}

enum DonationMethod {
  CREDIT_CARD
  ACH
  CHECK
  CASH
  IN_KIND
  OTHER
}

enum Frequency {
  ONE_TIME
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum DataType {
  STRING
  INT
  FLOAT
  BOOLEAN
  DATE
  JSON
  PICKLIST
}

enum AppliesTo {
  CONSTITUENT
  DONATION
  PLEDGE
  RECURRING_DONATION
  INTERACTION
  CAMPAIGN
  FUND
  TRIBUTE
  TASK
  FILE_ATTACHMENT
  ADDRESS
  EMAIL
  PHONE
}

model Fund {
  id             String       @id @default(uuid())
  name           String
  isActive       Boolean?     @default(true)
  isDefault      Boolean?     @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  pledgeFunds        Pledge[]
  donations          Donation[]
  recurringDonations RecurringDonation[]

}

model Constituent {
  id              String    @id @default(uuid())
  accountNumber   String    @unique // external key if present
  type            String? // Individual / Organization, etc.
  status          String?
  firstName       String?
  middleName      String?
  lastName        String?
  fullName        String?
  informalName    String?
  formalName      String?
  recognitionName String?
  sortName        String?
  prefix          String?
  suffix          String?
  birthdate       DateTime?
  gender          Gender?
  jobTitle        String?
  employer        String?
  website         String?
  facebookId      String?
  twitterId       String?
  linkedInId      String?
  envelopeName    String?

  // Preferences
  communicationChannelPreferred String?
  emailInterestIsActive         Boolean? // high-level flag
  lastModifiedDate              DateTime?
  lastModifiedName              String?
  createdDate                   DateTime? @default(now())
  createdName                   String?

  // Relations
  donor          Donor?
  emails         Email[]
  phones         Phone[]
  addresses      Address[]
  households     HouseholdMember[]
  donations      Donation[]
  pledges        Pledge[]
  recurring      RecurringDonation[]
  interactions   Interaction[]
  softCredits    SoftCredit[]
  files          FileAttachment[]
  refunds        Refund[]
  tasks          Task[]
  notes          Note[]
  wallets        WalletItem[]
  tributesMade   Tribute[]           @relation("TributesByConstituent")
  tributeHonors  TributeHonor[] // who is honored/memorialized
  emailInterests EmailInterest[]
}

model Household {
  id              String   @id @default(uuid())
  accountNumber   String   @unique
  name            String?
  fullName        String?
  informalName    String?
  formalName      String?
  envelopeName    String?
  recognitionName String?
  sortName        String?
  status          String?
  headId          String? // optional pointer to a member
  createdAt       DateTime @default(now())

  members HouseholdMember[]
}

model HouseholdMember {
  id            String  @id @default(uuid())
  householdId   String
  constituentId String
  role          String? // Head/Spouse/Child/etc.

  household   Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  constituent Constituent @relation(fields: [constituentId], references: [id], onDelete: Cascade)

  @@unique([householdId, constituentId])
  @@index([constituentId])
}

model Email {
  id               String     @id @default(uuid())
  constituentId    String
  type             EmailType?
  value            String
  isPrimary        Boolean?   @default(false)
  isBad            Boolean?   @default(false)
  createdName      String?
  lastModifiedName String?
  createdAt        DateTime   @default(now())

  constituent Constituent @relation(fields: [constituentId], references: [id], onDelete: Cascade)

  @@index([constituentId])
}

model Phone {
  id            String     @id @default(uuid())
  constituentId String
  type          PhoneType?
  number        String
  extension     String?
  isPrimary     Boolean?   @default(false)

  constituent Constituent @relation(fields: [constituentId], references: [id], onDelete: Cascade)

  @@index([constituentId])
}

model Address {
  id            String       @id @default(uuid())
  constituentId String
  type          AddressType?
  street        String?
  city          String?
  state         String?
  postalCode    String?
  county        String?
  country       String?
  isPrimary     Boolean?     @default(false)
  isBad         Boolean?     @default(false)

  constituent Constituent @relation(fields: [constituentId], references: [id], onDelete: Cascade)

  @@index([constituentId])
}

model Campaign {
  id        String    @id @default(uuid())
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean?  @default(true)

  appeals   Appeal[]
  donations Donation[]
}

model Appeal {
  id         String @id @default(uuid())
  campaignId String
  name       String

  campaign  Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  donations Donation[]

  @@index([campaignId])
}

model Designation {
  id     String  @id @default(uuid())
  number Int     @unique
  name   String?

  donations          Donation[]
  recurringDonations RecurringDonation[]
}

model Donation {
  id                String          @id @default(uuid())
  transactionNumber Int?            @unique
  amount            Float
  nonDeductible     Int? // in cents
  method            DonationMethod?
  inKindType        String?
  inKindDescription String?
  inKindMarketValue Int?
  checkDate         DateTime?
  checkNumber       String?
  date              DateTime? // Transaction date

  // foreign keys
  campaignId         String?
  appealId           String?
  fundId             String?
  designationId      String?
  donorId            String
  interactionLinkId  String? // optional link to interaction
  tributeId          String? // link to tribute, if any
  processorAccountId String?
  constituentId      String

  acknowledgmentStatus Boolean? // acked/thank-you sent
  createdDate          DateTime  @default(now())
  createdName          String?
  lastModifiedDate     DateTime?
  lastModifiedName     String?
  note                 String?

  isCompanyMatch Boolean? @default(false)

  // Processor references
  paymentToken String?

  // Relations
  constituent Constituent  @relation(fields: [constituentId], references: [id], onDelete: Cascade)
  campaign    Campaign?    @relation(fields: [campaignId], references: [id])
  appeal      Appeal?      @relation(fields: [appealId], references: [id])
  fund        Fund?        @relation(fields: [fundId], references: [id])
  designation Designation? @relation(fields: [designationId], references: [id])
  tribute     Tribute?     @relation(fields: [tributeId], references: [id])
  donor       Donor        @relation(fields: [donorId], references: [id], onDelete: Cascade)
  interaction Interaction? @relation("InteractionDonations", fields: [interactionLinkId], references: [id])

  softCredits       SoftCredit[]
  files             FileAttachment[]
  refunds           Refund[]
  processing        ProcessingInfo?
  pledgePayments    PledgePayment[]
  recurringPayments RecurringDonationPayment[]

  @@index([constituentId])
  @@index([campaignId, appealId, fundId, designationId])
}

model ProcessingInfo {
  id                                String  @id @default(uuid())
  donationId                        String  @unique
  token                             String?
  amount                            Int?
  transactionNumber                 Int?
  transactionProcessorAccountNumber Int?

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
}

model Refund {
  id               String    @id @default(uuid())
  amount           Int
  date             DateTime?
  createdDate      DateTime  @default(now())
  createdName      String?
  lastModifiedDate DateTime?
  lastModifiedName String?
  note             String?

  donationId    String
  constituentId String
  constituent   Constituent @relation(fields: [constituentId], references: [id], onDelete: Cascade)
  donation      Donation    @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@index([donationId])
  @@index([constituentId])
}

model Pledge {
  id                   String    @id @default(uuid())
  constituentId        String
  fundId               String?
  amount               Int
  frequency            Frequency
  firstInstallmentDate DateTime
  createdDate          DateTime  @default(now())
  createdName          String?
  lastModifiedDate     DateTime?
  lastModifiedName     String?
  acknowledgmentStatus Boolean?
  note                 String?

  constituent Constituent     @relation(fields: [constituentId], references: [id], onDelete: Cascade)
  fund        Fund?           @relation(fields: [fundId], references: [id])
  payments    PledgePayment[]

  @@index([constituentId])
}

model PledgePayment {
  id                         String    @id @default(uuid())
  pledgeId                   String
  donationId                 String? // if a payment resulted in a Donation entry
  transactionNumber          Int?
  amount                     Int
  createdDate                DateTime  @default(now())
  createdName                String?
  lastModifiedDate           DateTime?
  lastModifiedName           String?
  nonDeductible              Int?
  referenceDesignationNumber Int?
  acknowledgmentStatus       Boolean?
  checkDate                  DateTime?
  checkNumber                String?
  note                       String?

  pledge   Pledge    @relation(fields: [pledgeId], references: [id], onDelete: Cascade)
  donation Donation? @relation(fields: [donationId], references: [id])

  @@index([pledgeId])
  @@index([donationId])
}

model RecurringDonation {
  id                   String    @id @default(uuid())
  constituentId        String
  fundId               String?
  designationId        String?
  amount               Int
  frequency            Frequency
  startDate            DateTime?
  endDate              DateTime?
  note                 String?
  createdDate          DateTime  @default(now())
  createdName          String?
  lastModifiedDate     DateTime?
  lastModifiedName     String?
  acknowledgmentStatus Boolean?

  constituent Constituent                @relation(fields: [constituentId], references: [id], onDelete: Cascade)
  fund        Fund?                      @relation(fields: [fundId], references: [id])
  designation Designation?               @relation(fields: [designationId], references: [id])
  payments    RecurringDonationPayment[]

  @@index([constituentId])
}

model RecurringDonationPayment {
  id                         String    @id @default(uuid())
  recurringId                String
  donationId                 String? // may map to a Donation
  transactionNumber          Int?
  amount                     Int
  createdDate                DateTime  @default(now())
  createdName                String?
  lastModifiedDate           DateTime?
  lastModifiedName           String?
  nonDeductible              Int?
  referenceDesignationNumber Int?
  acknowledgmentStatus       Boolean?
  note                       String?

  recurring RecurringDonation @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  donation  Donation?         @relation(fields: [donationId], references: [id])

  @@index([recurringId])
  @@index([donationId])
}

model Relationship {
  id               String    @id @default(uuid())
  accountNumber1   String // First constituent
  accountNumber2   String // Second constituent
  role1            String? // Role of constituent 1
  role2            String? // Role of constituent 2
  relationshipRole String? // General relationship descriptor
  isActive         Boolean   @default(true)
  note             String?
  createdDate      DateTime  @default(now())
  createdName      String?
  lastModifiedDate DateTime?
  lastModifiedName String?

  @@index([accountNumber1])
  @@index([accountNumber2])
}

model SoftCredit {
  id                String    @id @default(uuid())
  donationId        String
  interactionId     String? // Can also be linked to interactions
  creditedToId      String // constituent receiving credit
  amount            Int
  designationNumber Int?
  createdDate       DateTime  @default(now())
  createdName       String?
  lastModifiedDate  DateTime?
  lastModifiedName  String?
  acknowledged      Boolean?  @default(false)
  reference         Int?
  note              String?

  donation   Donation    @relation(fields: [donationId], references: [id], onDelete: Cascade)
  creditedTo Constituent @relation(fields: [creditedToId], references: [id])

  @@index([donationId])
  @@index([creditedToId])
}

model FileAttachment {
  id                String   @id @default(uuid())
  url               String
  name              String?
  createdDateUtc    DateTime @default(now())
  designationNumber Int?
  interactionId     String?
  noteId            String?
  taskId            String?
  transactionNumber Int?

  constituentId     String?
  donationId        String?
  interactionLinkId String?
  taskLinkId        String?

  donation    Donation?    @relation(fields: [donationId], references: [id])
  interaction Interaction? @relation(fields: [interactionLinkId], references: [id])
  task        Task?        @relation(fields: [taskLinkId], references: [id])
  constituent Constituent? @relation(fields: [constituentId], references: [id])

  @@index([donationId])
  @@index([interactionLinkId])
  @@index([taskLinkId])
}

model Interaction {
  id                String       @id @default(uuid())
  constituentId     String
  subject           String?
  channel           String? // phone/email/in-person/etc.
  type              EventType?
  status            EventStatus?
  date              DateTime?
  createdDate       DateTime     @default(now())
  createdName       String?
  lastModifiedDate  DateTime?
  lastModifiedName  String?
  purpose           String?
  readinessForAsk   String?
  reasonForInterest String?
  invitedBy         String?
  askers            String?
  askAmount         Int?
  askByWhen         DateTime?
  teamLeader        String?
  tableCaptains     String?
  levelsOfInterest  String?
  inbound           Boolean?
  note              String?

  constituent  Constituent      @relation(fields: [constituentId], references: [id], onDelete: Cascade)
  ambassadors  Ambassadors[]
  buckets      Bucket[]
  files        FileAttachment[]
  transactions Donation[]       @relation("InteractionDonations") // optional if linking

  @@index([constituentId])
}

model Ambassadors {
  id            String      @id @default(uuid())
  name          String
  interactionId String
  interaction   Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@index([interactionId])
}

model Bucket {
  id            String      @id @default(uuid())
  name          String
  interactionId String
  interaction   Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@index([interactionId])
}

model Note {
  id            String       @id @default(uuid())
  constituentId String?
  note          String
  createdDate   DateTime     @default(now())
  createdName   String?
  constituent   Constituent? @relation(fields: [constituentId], references: [id], onDelete: Cascade)

  @@index([constituentId])
}

model Task {
  id                    String    @id @default(uuid())
  constituentId         String?
  name                  String
  notes                 String?
  note                  String?
  shouldApplySoftCredit Boolean?  @default(false)
  status                Boolean? // completed status
  eventStatus           String? // status descriptor
  eventType             String?
  purpose               String?
  subject               String?
  ambassador            String?
  askers                String?
  askAmount             Int?
  buckets               String?
  channel               String?
  invitedBy             String?
  levelsOfInterest      String?
  readinessForAsk       String?
  teamLeader            String?
  tableCaptains         String?
  isActive              Boolean?  @default(true)
  userName              String?
  createdDate           DateTime  @default(now())
  createdName           String?
  lastModifiedDate      DateTime?
  lastModifiedName      String?
  completedDate         DateTime?
  date                  DateTime?

  constituent Constituent?     @relation(fields: [constituentId], references: [id])
  files       FileAttachment[]

  @@index([constituentId])
}

model Tribute {
  id          String         @id @default(uuid())
  name        String
  type        String? // honor/memory/etc.
  note        String?
  isActive    Boolean?       @default(true)
  notificants Int? // count if you track
  donations   Donation[]
  honors      TributeHonor[]

  constituentId String
  constituent   Constituent @relation("TributesByConstituent", fields: [constituentId], references: [id], onDelete: Cascade)

}

model TributeHonor {
  id            String  @id @default(uuid())
  tributeId     String
  constituentId String
  note          String?

  tribute     Tribute     @relation(fields: [tributeId], references: [id], onDelete: Cascade)
  constituent Constituent @relation(fields: [constituentId], references: [id])

  @@index([tributeId])
  @@index([constituentId])
}

model WalletItem {
  id                     String    @id @default(uuid())
  constituentId          String
  designationNumber      Int?
  creditCardType         String?
  creditCardNumberMasked String?
  creditCardExpiration   DateTime?
  eftAccountType         String?
  eftAccountNumberMasked String?
  eftRoutingNumberMasked String?
  paymentMethodToken     String?

  constituent Constituent @relation(fields: [constituentId], references: [id], onDelete: Cascade)

  @@index([constituentId])
}

model TransactionProcessorAccount {
  id              String  @id @default(uuid())
  name            String
  isActive        Boolean @default(true)
  stripeAccountId String?
  appliesTo       String? // freeform or enum
  categoryName    String?
  dataType        String?
  type            String?
}

model EmailInterest {
  id            String   @id @default(uuid())
  constituentId String
  name          String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  constituent Constituent @relation(fields: [constituentId], references: [id], onDelete: Cascade)

  @@index([constituentId])
}

model CustomField {
  id         String    @id @default(uuid())
  name       String
  appliesTo  AppliesTo
  dataType   DataType
  isRequired Boolean   @default(false)
  isActive   Boolean   @default(true)
  picklist   Json? // list of allowed values if DataType = PICKLIST
  helpText   String?

  values CustomValue[]

  @@unique([name, appliesTo])
}

model CustomValue {
  id          String    @id @default(uuid())
  fieldId     String
  entityType  AppliesTo
  entityId    String // stores the target model's id as string (no FK across models)
  // Store the value in one of these columns; use one per row depending on field.dataType
  valueString String?
  valueInt    Int?
  valueFloat  Float?
  valueBool   Boolean?
  valueDate   DateTime?
  valueJson   Json?

  field CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  // one value per entity per field
  @@index([entityType, entityId])
  @@unique([fieldId, entityType, entityId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}
