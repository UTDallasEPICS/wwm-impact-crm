datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  password  String
  role      Role     @default(STANDARD)

  organizations UserOrganization[]
}

enum Role {
  STANDARD
  ADMIN
}

model Organization {
  id      Int       @id @default(autoincrement())
  name    String

  users   UserOrganization[]
  donors  Donor[]
  funds   Fund[]
  reports Report[]
}

model Donor {
  id             Int            @id @default(autoincrement())
  email          String
  firstName      String
  lastName       String
  organizationId Int
  organization   Organization   @relation(fields: [organizationId], references: [id])

  donations      Donation[]
  @@unique([organizationId, email])  // ensures uniqueness within an org
}

model Fund {
  id             String            @id @default(uuid())
  name           String
  isActive  Boolean
  isDefault Boolean
  organizationId Int
  organization   Organization   @relation(fields: [organizationId], references: [id])

  donations      Donation[]
}

model Campaign {
  id        Int        @id @default(autoincrement())
  name      String
  startDate DateTime
  endDate   DateTime?

  donations Donation[]
}

model Donation {
  id         Int        @id @default(autoincrement())
  donorId    Int
  donor      Donor      @relation(fields: [donorId], references: [id])

  fundId     String
  fund       Fund       @relation(fields: [fundId], references: [id])

  campaignId Int?
  campaign   Campaign?  @relation(fields: [campaignId], references: [id])

  amount     Float
  date       DateTime
}


model Report {
  id             Int           @id @default(autoincrement())
  name           String
  type           ReportType    @default(CUSTOM)
  config         Json          // filters/metrics stored here

  organizationId Int
  organization   Organization  @relation(fields: [organizationId], references: [id])

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum ReportType {
  ORG_KPI
  FUND_PERFORMANCE
  DONOR_DRILLDOWN
  CUSTOM
}

model UserOrganization {
  id              Int           @id @default(autoincrement())
  userId          Int
  organizationId  Int

  user            User          @relation(fields: [userId], references: [id])
  organization    Organization  @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
}

model Note {
  id                String   @id @default(uuid())
  AccountNumber     String   @default(uuid()) // Account Number ID (UUID)
  Note              String
  CreatedName       String
  CreatedDate       DateTime
  Date              DateTime
  LastModifiedName  String
  LastModifiedDate  DateTime
}

model SoftCredits {
  id                 String   @id @default(uuid())
  AccountNumber      String   @default(uuid()) // UUID of the constituent account
  Amount             Int
  AcknowledgeStatus  Boolean
  Reference          Int
  CreatedName        String
  CreatedDate        DateTime
  LastModified       DateTime
  DesignationNumber  Float
}

model Appeals {
  
  name     String
  isActive Boolean
  uuid     String  @id @default(uuid())
  goal     Int

}


model Address {
  id            String  @id 
  UUID          String @default(uuid())
  AccountNumber Int
  TypeName      String
  Street        String
  State         String
  PostalCode    String
  City          String
  Country       String
  County        String
  IsBad         Boolean
  IsPrimary     Boolean
}




model Transactions {
  TransactionNumber String  
  AccountNumber     String   @id @default(uuid()) // UUID as primary key
  Amount            Int
  Date              DateTime
  CreatedDate       DateTime
  LastModifiedDate  DateTime
  Method            String
  CreatedName       String
  LastModifiedName  String
}


model CustomFields {
  id                 String  @id @default(uuid()) // Primary key
  Name               String
  Category           String
  PickType           String
  DataType           String
  AppliesTo          String
  InactivePickValues Int
  IsRequired         Boolean @default(false)
  IsActive           Boolean
}
